rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    // Role is granted ONLY by the Firebase project owner in Firestore console.
    function admin() {
      return loggedIn() && exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
        && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.active == true;
    }
    match /administrators/{adminUid} {
      allow get: if loggedIn() && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }
    function approved() {
      return loggedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }
    match /users/{userId} {
      allow get: if admin() || (loggedIn() && request.auth.uid == userId);
      allow list: if admin();
      allow create: if loggedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email','name','username','recoveryEmail','approved'])
        && request.resource.data.keys().hasOnly(['email','name','username','recoveryEmail','approved'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9._-]{3,30}$')
        && request.resource.data.email == request.resource.data.username + '@users.frakturkalender.invalid'
        && request.resource.data.recoveryEmail is string
        && request.resource.data.recoveryEmail.size() <= 254
        && request.resource.data.approved == false;
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
        && request.resource.data.approved is bool;
      allow delete: if false;
    }
    match /registrations/{recordId} {
      allow read: if true;
      function owner() { return loggedIn() && resource.data.uid == request.auth.uid; }
      function valid() {
        let x = request.resource.data;
        return x.keys().hasAll(['uid','name','date','month','count'])
          && x.keys().hasOnly(['uid','name','date','month','count'])
          && x.uid == request.auth.uid
          && (x.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
            || x.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name)
          && x.date is string && x.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && x.month is string && x.month.matches('^[0-9]{4}-[0-9]{2}$')
          && x.month == x.date.split('-')[0] + '-' + x.date.split('-')[1]
          && x.count is int && x.count >= 0 && x.count <= 9999
          && recordId == request.auth.uid + '_' + x.date;
      }
      // Special case: project administrator may create an archival registration
      // for an EXISTING user, never changing an existing document.
      // Data and document ID are checked against that account's profile.
      function validAdminArchive() {
        let x = request.resource.data;
        return admin()
          && x.keys().hasAll(['uid','name','date','month','count'])
          && x.keys().hasOnly(['uid','name','date','month','count'])
          && x.uid is string
          && exists(/databases/$(database)/documents/users/$(x.uid))
          && x.name == get(/databases/$(database)/documents/users/$(x.uid)).data.username
          && x.date is string && x.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && x.month is string && x.month == x.date.split('-')[0] + '-' + x.date.split('-')[1]
          && x.count is int && x.count >= 0 && x.count <= 9999
          && recordId == x.uid + '_' + x.date;
      }
      allow create: if ((admin() || approved()) && valid()) || validAdminArchive();
      // Approved users may edit their own records, without changing identity/date.
      allow update: if (approved() || admin()) && owner() && valid()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.date == resource.data.date;
      // Admin may change ONLY the count on any existing registration.
      // The name, owner, date, and month are immutable.
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 9999;
      allow delete: if admin() || (approved() && owner());
    }
  }
}
