rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{recordId} {
      // Kalendern kan läsas av alla, även utan inloggning.
      allow read: if true;
      function owner() { return request.auth != null && request.auth.uid == resource.data.uid; }
      function valid() {
        let x = request.resource.data;
        return x.keys().hasAll(['uid','name','date','month','count'])
          && x.keys().hasOnly(['uid','name','date','month','count'])
          && x.uid == request.auth.uid
          && x.name is string && x.name.size() >= 1 && x.name.size() <= 60
          && x.date is string && x.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && x.month is string && x.month.matches('^\\d{4}-\\d{2}$')
          && x.month == x.date.substring(0,7)
          && x.count is int && x.count >= 1 && x.count <= 9999
          && recordId == request.auth.uid + '_' + x.date;
      }
      allow create: if request.auth != null && valid();
      allow update: if owner() && valid() && request.resource.data.uid == resource.data.uid && request.resource.data.date == resource.data.date;
      allow delete: if owner();
    }
  }
}
